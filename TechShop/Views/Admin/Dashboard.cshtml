@model TechShop.ViewModels.AdminDashboardViewModel
@using System.Globalization
@{
    var currentLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    ViewData["Title"] = " - Admin Dashboard";

    string T(string fr, string en, string ar) => currentLanguage switch
    {
        "en" => en,
        "ar" => ar,
        _ => fr
    };
}

<style>
    .admin-dashboard-container {
        background: linear-gradient(135deg, #0f3460 0%, #162a56 100%);
        min-height: 100vh;
        padding: 40px 0;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        padding: 0 20px;
    }

    .dashboard-title {
        color: white;
        font-weight: 800;
        font-size: 2.5rem;
        margin: 0;
    }

    .dashboard-actions {
        display: flex;
        gap: 10px;
    }

    .action-btn {
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        text-decoration: none;
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .action-btn-primary {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    }

    .action-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(231, 76, 60, 0.3);
        color: white;
    }

    .action-btn-secondary {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
    }

    .action-btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(52, 152, 219, 0.3);
        color: white;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        border-left: 5px solid;
        position: relative;
        overflow: hidden;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    }

    .stat-card.orders {
        border-left-color: #3498db;
    }

    .stat-card.pending {
        border-left-color: #f39c12;
    }

    .stat-card.validated {
        border-left-color: #27ae60;
    }

    .stat-card.customers {
        border-left-color: #9b59b6;
    }

    .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .stat-orders .stat-icon { color: #3498db; }
    .stat-pending .stat-icon { color: #f39c12; }
    .stat-validated .stat-icon { color: #27ae60; }
    .stat-customers .stat-icon { color: #9b59b6; }

    .stat-label {
        color: #7f8c8d;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        color: #1a1a2e;
    }

    .revenue-card {
        background: linear-gradient(135deg, rgba(52, 152, 219, 0.1) 0%, rgba(41, 128, 185, 0.1) 100%);
        border: 2px solid rgba(52, 152, 219, 0.3);
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        text-align: center;
    }

    .revenue-label {
        color: #7f8c8d;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .revenue-value {
        font-size: 2.8rem;
        font-weight: 800;
        color: #2980b9;
    }

    .orders-section {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-title i {
        color: #3498db;
        font-size: 1.8rem;
    }

    .table-container {
        overflow-x: auto;
    }

    .admin-table {
        border-collapse: collapse;
        width: 100%;
    }

    .admin-table thead {
        background: rgba(15, 52, 96, 0.08);
    }

    .admin-table th {
        padding: 15px;
        text-align: left;
        color: #1a1a2e;
        font-weight: 700;
        border-bottom: 2px solid rgba(15, 52, 96, 0.15);
        font-size: 0.95rem;
    }

    .admin-table td {
        padding: 15px;
        border-bottom: 1px solid rgba(15, 52, 96, 0.08);
        color: #555;
    }

    .admin-table tbody tr:hover {
        background: rgba(15, 52, 96, 0.04);
    }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-pending {
        background: rgba(243, 156, 18, 0.2);
        color: #e67e22;
    }

    .status-validated {
        background: rgba(39, 174, 96, 0.2);
        color: #27ae60;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .action-btn-small {
        padding: 6px 12px;
        font-size: 0.85rem;
        border-radius: 6px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .action-btn-validate {
        background: #27ae60;
        color: white;
    }

    .action-btn-validate:hover {
        background: #229954;
        transform: translateY(-1px);
    }

    .action-btn-view {
        background: #3498db;
        color: white;
    }

    .action-btn-view:hover {
        background: #2980b9;
        transform: translateY(-1px);
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #95a5a6;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .empty-state-text {
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            gap: 20px;
            text-align: center;
        }

        .dashboard-title {
            font-size: 2rem;
        }

        .dashboard-actions {
            justify-content: center;
            flex-wrap: wrap;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .admin-table {
            font-size: 0.85rem;
        }

        .admin-table th,
        .admin-table td {
            padding: 10px;
        }
    }
</style>

<div class="admin-dashboard-container">
    <div class="container">
        <!-- Header avec titre et actions -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">
                <i class="fas fa-chart-line me-2"></i>@T("Tableau de bord", "Dashboard", "لوحة التحكم")
            </h1>
            <div class="dashboard-actions">
                <a asp-action="CreateProduct" asp-controller="Admin" class="action-btn action-btn-primary">
                    <i class="fas fa-plus"></i>@T("Ajouter produit", "Add Product", "إضافة منتج")
                </a>
                <a asp-action="Products" asp-controller="Admin" class="action-btn action-btn-secondary">
                    <i class="fas fa-boxes"></i>@T("Gérer produits", "Manage Products", "إدارة المنتجات")
                </a>
            </div>
        </div>

        <!-- Cartes de statistiques -->
        <div class="stats-grid">
            <div class="stat-card orders stat-orders">
                <div class="stat-icon">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="stat-label">@T("Total", "Total", "الإجمالي")</div>
                <div class="stat-value">@Model.TotalOrders</div>
                <small class="text-muted">@T("commandes", "orders", "الطلبات")</small>
            </div>

            <div class="stat-card pending stat-pending">
                <div class="stat-icon">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div class="stat-label">@T("En attente", "Pending", "قيد الانتظار")</div>
                <div class="stat-value">@Model.PendingOrders</div>
                <small class="text-muted">@T("à valider", "to validate", "للتحقق")</small>
            </div>

            <div class="stat-card validated stat-validated">
                <div class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-label">@T("Validées", "Validated", "تم التحقق")</div>
                <div class="stat-value">@Model.ValidatedOrders</div>
                <small class="text-muted">@T("confirmées", "confirmed", "مؤكدة")</small>
            </div>

            <div class="stat-card customers stat-customers">
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-label">@T("Clients", "Customers", "العملاء")</div>
                <div class="stat-value">@Model.TotalCustomers</div>
                <small class="text-muted">@T("enregistrés", "registered", "مسجلين")</small>
            </div>
        </div>

        <!-- Chiffre d'affaires -->
        <div class="revenue-card">
            <div class="revenue-label">
                <i class="fas fa-chart-pie me-2"></i>@T("Chiffre d'affaires total", "Total Revenue", "إجمالي الإيرادات")
            </div>
            <div class="revenue-value">@Model.TotalRevenue.ToString("0.00") DT</div>
        </div>

        <!-- Dernières commandes -->
        <div class="orders-section">
            <h2 class="section-title">
                <i class="fas fa-history"></i>@T("Dernières commandes", "Latest Orders", "أحدث الطلبات")
            </h2>

            @if (!Model.LatestOrders.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-inbox"></i>
                    </div>
                    <p class="empty-state-text">@T("Aucune commande pour le moment", "No orders yet", "لا توجد طلبات في الوقت الحالي")</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>@T("Référence", "Reference", "المرجع")</th>
                                <th>@T("Client", "Customer", "العميل")</th>
                                <th>@T("Montant", "Amount", "المبلغ")</th>
                                <th>@T("Statut", "Status", "الحالة")</th>
                                <th>@T("Actions", "Actions", "الإجراءات")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.LatestOrders)
                            {
                                <tr>
                                    <td>
                                        <strong>#@order.OrderId.ToString().Substring(0, 8)...</strong>
                                    </td>
                                    <td>@order.CustomerName</td>
                                    <td><strong>@order.TotalAmount.ToString("0.00") DT</strong></td>
                                    <td>
                                        @if (order.Status == TechShop.Models.OrderStatus.Pending)
                                        {
                                            <span class="status-badge status-pending">
                                                <i class="fas fa-clock me-1"></i>@T("En attente", "Pending", "قيد الانتظار")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-validated">
                                                <i class="fas fa-check me-1"></i>@T("Validée", "Validated", "تم التحقق")
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            @if (order.Status == TechShop.Models.OrderStatus.Pending)
                                            {
                                                <form method="post" asp-action="ValidateOrder" style="display: inline;">
                                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                                    <button type="submit" class="action-btn-small action-btn-validate" title="@T("Valider cette commande", "Validate this order", "التحقق من هذا الطلب")">
                                                        <i class="fas fa-check"></i> @T("Valider", "Validate", "التحقق")
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="ViewOrder" asp-controller="Admin" asp-route-orderId="@order.OrderId" class="action-btn-small action-btn-view" title="@T("Voir les détails", "View details", "عرض التفاصيل")">
                                                <i class="fas fa-eye"></i> @T("Détails", "Details", "التفاصيل")
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
