@model TechShop.Models.Order
@using System.Globalization
@{
    var currentLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    ViewData["Title"] = " - Détails de la commande";

    string T(string fr, string en, string ar) => currentLanguage switch
    {
        "en" => en,
        "ar" => ar,
        _ => fr
    };
}

<style>
    .order-detail-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 40px 0;
    }

    .order-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        padding: 40px;
        margin-bottom: 30px;
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 30px;
        border-bottom: 2px solid rgba(15, 52, 96, 0.1);
    }

    .order-title {
        font-size: 2rem;
        font-weight: 800;
        color: #1a1a2e;
        margin: 0;
    }

    .status-badge-large {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .status-pending-large {
        background: rgba(243, 156, 18, 0.2);
        color: #e67e22;
    }

    .status-validated-large {
        background: rgba(39, 174, 96, 0.2);
        color: #27ae60;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-item {
        background: rgba(15, 52, 96, 0.03);
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid var(--ts-accent, #0f3460);
    }

    .info-label {
        color: #7f8c8d;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .info-value {
        color: #1a1a2e;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .items-section {
        margin-top: 30px;
    }

    .section-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid rgba(15, 52, 96, 0.1);
    }

    .items-table {
        width: 100%;
        border-collapse: collapse;
    }

    .items-table thead {
        background: rgba(15, 52, 96, 0.08);
    }

    .items-table th {
        padding: 15px;
        text-align: left;
        color: #1a1a2e;
        font-weight: 700;
        border-bottom: 2px solid rgba(15, 52, 96, 0.15);
        font-size: 0.95rem;
    }

    .items-table td {
        padding: 15px;
        border-bottom: 1px solid rgba(15, 52, 96, 0.08);
        color: #555;
    }

    .items-table tbody tr:hover {
        background: rgba(15, 52, 96, 0.04);
    }

    .summary-section {
        margin-top: 30px;
        padding: 20px;
        background: rgba(15, 52, 96, 0.03);
        border-radius: 10px;
        border-left: 5px solid #27ae60;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 1rem;
    }

    .summary-label {
        color: #555;
        font-weight: 600;
    }

    .summary-value {
        color: #1a1a2e;
        font-weight: 700;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        padding-top: 12px;
        border-top: 2px solid rgba(15, 52, 96, 0.1);
        margin-top: 12px;
        font-size: 1.2rem;
    }

    .summary-total-label {
        color: #1a1a2e;
        font-weight: 800;
    }

    .summary-total-value {
        color: #27ae60;
        font-weight: 800;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        padding-top: 30px;
        border-top: 2px solid rgba(15, 52, 96, 0.1);
    }

    .action-btn {
        padding: 12px 30px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .action-btn-validate {
        background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
        color: white;
    }

    .action-btn-validate:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(39, 174, 96, 0.3);
    }

    .action-btn-back {
        background: #e9ecef;
        color: #333;
    }

    .action-btn-back:hover {
        background: #dee2e6;
        transform: translateY(-2px);
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #95a5a6;
    }

    @@media (max-width: 768px) {
        .order-header {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .order-title {
            font-size: 1.5rem;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .items-table {
            font-size: 0.9rem;
        }

        .items-table th,
        .items-table td {
            padding: 10px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .action-btn {
            justify-content: center;
        }
    }
</style>

<div class="order-detail-container">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-action="Dashboard" asp-controller="Admin">
                        <i class="fas fa-chart-line me-1"></i>@T("Tableau de bord", "Dashboard", "لوحة التحكم")
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    <i class="fas fa-receipt me-1"></i>@T("Détails de la commande", "Order Details", "تفاصيل الطلب")
                </li>
            </ol>
        </nav>

        <!-- Order Details Card -->
        <div class="order-card">
            <!-- Header with Title and Status -->
            <div class="order-header">
                <h1 class="order-title">
                    <i class="fas fa-receipt me-2"></i>@T("Commande", "Order", "الطلب") #@Model.OrderId.ToString().Substring(0, 8).ToUpper()
                </h1>
                <span class="status-badge-large @(Model.Status == TechShop.Models.OrderStatus.Pending ? "status-pending-large" : "status-validated-large")">
                    @if (Model.Status == TechShop.Models.OrderStatus.Pending)
                    {
                        <i class="fas fa-hourglass-half me-2"></i>
                        @T("En attente", "Pending", "قيد الانتظار")
                    }
                    else
                    {
                        <i class="fas fa-check-circle me-2"></i>
                        @T("Validée", "Validated", "تم التحقق")
                    }
                </span>
            </div>

            <!-- Customer and Order Info -->
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-user me-1"></i>@T("Client", "Customer", "العميل")
                    </div>
                    <div class="info-value">@Model.CustomerName</div>
                </div>

                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-envelope me-1"></i>@T("Email", "Email", "البريد الإلكتروني")
                    </div>
                    <div class="info-value">
                        <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-calendar me-1"></i>@T("Date", "Date", "التاريخ")
                    </div>
                    <div class="info-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>

                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-hashtag me-1"></i>@T("Référence", "Reference", "المرجع")
                    </div>
                    <div class="info-value">@Model.OrderId</div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="items-section">
                <h2 class="section-title">
                    <i class="fas fa-box me-2"></i>@T("Articles commandés", "Ordered Items", "المنتجات المطلوبة")
                </h2>

                @if (!Model.Items.Any())
                {
                    <div class="empty-state">
                        <div>
                            <i class="fas fa-inbox" style="font-size: 2rem; opacity: 0.5;"></i>
                            <p>@T("Aucun article", "No items", "لا توجد منتجات")</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="items-table">
                            <thead>
                                <tr>
                                    <th>@T("Produit", "Product", "المنتج")</th>
                                    <th>@T("Prix unitaire", "Unit Price", "السعر للقطعة")</th>
                                    <th>@T("Quantité", "Quantity", "الكمية")</th>
                                    <th>@T("Total", "Total", "الإجمالي")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.ProductName</strong>
                                        </td>
                                        <td>@item.UnitPrice.ToString("0.00") DT</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td><strong>@item.TotalPrice.ToString("0.00") DT</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Summary -->
            <div class="summary-section">
                <div class="summary-row">
                    <span class="summary-label">@T("Sous-total", "Subtotal", "المجموع الفرعي")</span>
                    <span class="summary-value">@Model.TotalAmount.ToString("0.00") DT</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">@T("Frais de port", "Shipping", "رسوم الشحن")</span>
                    <span class="summary-value">0.00 DT</span>
                </div>
                <div class="summary-total">
                    <span class="summary-total-label">@T("Montant total", "Total Amount", "الكمية الإجمالية")</span>
                    <span class="summary-total-value">@Model.TotalAmount.ToString("0.00") DT</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="action-buttons">
                @if (Model.Status == TechShop.Models.OrderStatus.Pending)
                {
                    <form method="post" asp-action="ValidateOrder" style="display: inline;">
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <button type="submit" class="action-btn action-btn-validate">
                            <i class="fas fa-check-circle"></i> @T("Valider cette commande", "Validate this order", "التحقق من هذا الطلب")
                        </button>
                    </form>
                }
                <a asp-action="DownloadInvoice" asp-controller="Admin" asp-route-orderId="@Model.OrderId" class="action-btn" style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); color: white;">
                    <i class="fas fa-file-pdf"></i> @T("Télécharger la facture", "Download Invoice", "تحميل الفاتورة")
                </a>
                <a asp-action="Dashboard" asp-controller="Admin" class="action-btn action-btn-back">
                    <i class="fas fa-arrow-left"></i> @T("Retour au tableau de bord", "Back to dashboard", "العودة إلى لوحة التحكم")
                </a>
            </div>
        </div>
    </div>
</div>
