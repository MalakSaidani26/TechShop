@model TechShop.ViewModels.HomeViewModel
@using System.Globalization

@{
    var currentLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    ViewData["Title"] = " - Accueil";

    string T(string fr, string en, string ar) => currentLanguage switch
    {
        "en" => en,
        "ar" => ar,
        _ => fr
    };
}

<!-- Hero Banner -->
<div class="hero-banner">
    <div class="container text-center py-5">
        <i class="fas fa-laptop fa-3x mb-3 text-white"></i>
        <h1 class="hero-title display-4">TechShop</h1>
        <p class="hero-subtitle lead">@T("Votre destination pour les meilleurs produits technologiques.", "Your destination for the best tech products.", "وجهتك لأفضل المنتجات التقنية.")</p>
        <a asp-controller="Product" asp-action="List" class="btn btn-light btn-lg mt-3">
            @T("Voir tous les produits", "Browse all products", "تصفح جميع المنتجات")
            <i class="fas fa-arrow-right ms-2"></i>
        </a>
    </div>
</div>

<!-- Produits de la semaine -->
<div class="container py-5">
    <div class="text-center mb-5">
        <h2>@T("Produits de la semaine", "Products of the week", "منتجات الأسبوع")</h2>
        <p class="text-muted">@T("Découvrez notre sélection hebdomadaire de produits phares.", "Discover our weekly selection of featured products.", "اكتشف تشكيلتنا الأسبوعية من المنتجات المميزة.")</p>
    </div>

    @if (!Model.ProductsOfTheWeek.Any())
    {
        <div class="alert alert-info text-center">
            @T("Aucun produit de la semaine pour le moment.", "No featured products this week.", "لا توجد منتجات مميزة هذا الأسبوع.")
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var product in Model.ProductsOfTheWeek)
            {
                <div class="col">
                    <div class="card product-card h-100">
                        <div class="product-image-wrapper position-relative">
                            <img src="@(string.IsNullOrEmpty(product.ImageFileName) ? "/images/products/placeholder.svg" : $"/images/products/{product.ImageFileName}")"
                                 class="card-img-top product-img"
                                 alt="@product.GetLocalizedName(currentLanguage)"
                                 loading="lazy"
                                 onerror="this.src='/images/products/placeholder.svg'" />
                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">
                                <i class="fas fa-star me-1"></i>@T("Semaine", "Featured", "مميز")
                            </span>
                            <span class="badge @(product.InStock ? "bg-success" : "bg-danger") stock-badge position-absolute bottom-0 start-0 m-2">
                                @(product.InStock ? "✓ En stock" : "✗ Hors stock")
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="product-category text-muted small mb-1">
                                @product.Category.GetLocalizedName(currentLanguage)
                            </p>
                            <h5 class="card-title product-name">
                                <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.ProductId"
                                       class="text-decoration-none">
                                    @product.GetLocalizedName(currentLanguage)
                                </a>
                            </h5>
                            <p class="card-text product-description text-muted">
                                @product.GetLocalizedShortDescription(currentLanguage)
                            </p>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 gap-2">
                                <span class="product-price fw-bold fs-5">
                                    @($"{product.Price:0.00} DT")
                                </span>
                                <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.ProductId"
                                       class="btn btn-outline-primary btn-sm">
                                    @T("Voir détails", "View details", "عرض التفاصيل")
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-5">
        <a asp-controller="Product" asp-action="List" class="btn btn-primary btn-lg">
            @T("Voir tous les produits", "Browse all products", "تصفح جميع المنتجات")
            <i class="fas fa-arrow-right ms-2"></i>
        </a>
    </div>
</div>