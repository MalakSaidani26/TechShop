@model ProductListViewModel
@using System.Globalization

@{
    var currentLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var selectedCategoryLabel = Model.SelectedCategoryId.HasValue
        ? Model.Categories.FirstOrDefault(c => c.CategoryId == Model.SelectedCategoryId.Value)?.GetLocalizedName(currentLanguage)
        : null;

    selectedCategoryLabel ??= T("Toutes les catégories", "All categories", "كل الفئات");

    string T(string fr, string en, string ar) => currentLanguage switch
    {
        "en" => en,
        "ar" => ar,
        _ => fr
    };
}

<!-- Bannière -->
<div class="hero-banner">
    <div class="container">
        <h1 class="hero-title">@T("Les produits", "Products", "المنتجات")</h1>
        <p class="hero-subtitle">@T("Découvrez nos derniers produits technologiques", "Discover our latest tech products", "اكتشف أحدث المنتجات التقنية")</p>
    </div>
</div>

<!-- Barre de recherche -->
<div class="search-container">
    <div class="container">
        <form method="get" asp-action="List" class="search-form search-form-advanced">
            <div class="category-filter-wrap category-filter-wrap-modern dropdown">
                <input type="hidden" id="categoryIdInput" name="categoryId" value="@Context.Request.Query["categoryId"]" />
                <button class="btn category-dropdown-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="category-filter-icon" aria-hidden="true"><i class="fas fa-layer-group"></i></span>
                    <span id="categorySelectedLabel" class="category-selected-label">@selectedCategoryLabel</span>
                </button>
                <ul class="dropdown-menu category-dropdown-menu">
                    <li>
                        <button type="button" class="dropdown-item category-option-btn @(Model.SelectedCategoryId is null ? "active" : string.Empty)" data-value="" data-label="@T("Toutes les catégories", "All categories", "كل الفئات")">
                            <i class="fas fa-border-all me-2"></i>@T("Toutes les catégories", "All categories", "كل الفئات")
                        </button>
                    </li>
                    @foreach (var category in Model.Categories)
                    {
                        <li>
                            <button type="button" class="dropdown-item category-option-btn @(Model.SelectedCategoryId == category.CategoryId ? "active" : string.Empty)" data-value="@category.CategoryId" data-label="@category.GetLocalizedName(currentLanguage)">
                                <i class="fas fa-tag me-2"></i>@category.GetLocalizedName(currentLanguage)
                            </button>
                        </li>
                    }
                </ul>
            </div>
            <input type="text"
                   name="searchQuery"
                   class="form-control"
                   value="@Context.Request.Query["searchQuery"]"
                   placeholder="@T("Rechercher un produit par nom...", "Search product by name...", "ابحث عن منتج بالاسم...")"
                   aria-label="@T("Recherche produits", "Product search", "بحث عن المنتجات")" />
            <button type="submit" class="btn-search">
                <i class="fas fa-search"></i>
                <span>@T("Chercher", "Search", "بحث")</span>
            </button>
        </form>
    </div>
</div>

<!-- Grille produits -->
<div class="container py-5">
    @if (TempData["CartMessage"] is string cartMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @cartMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card product-card h-100">

                    <!-- Image produit -->
                    <div class="product-image-wrapper position-relative">
                        <img src="@(string.IsNullOrEmpty(product.ImageFileName) ? "/images/products/placeholder.svg" : $"/images/products/{product.ImageFileName}")"
                             class="card-img-top product-img"
                             alt="@product.Name"
                             loading="lazy"
                             onerror="this.src='/images/products/placeholder.svg'" />

                        <!-- Badge Stock -->
                        <span class="badge @(product.InStock ? "bg-success" : "bg-danger") stock-badge position-absolute bottom-0 start-0 m-2">
                            @(product.InStock ? "✓ En stock" : "✗ Hors stock")
                        </span>
                    </div>

                    <!-- Informations produit -->
                    <div class="card-body d-flex flex-column">
                        <p class="product-category text-muted small mb-1">
                            @product.Category.GetLocalizedName(currentLanguage)
                        </p>

                        <h5 class="card-title product-name">@product.GetLocalizedName(currentLanguage)</h5>

                        <p class="card-text product-description text-muted">
                            @product.GetLocalizedShortDescription(currentLanguage)
                        </p>

                        <!-- Prix -->
                        <div class="mt-auto d-flex justify-content-between align-items-center pt-3 gap-2">
                            <span class="product-price fw-bold fs-5">
                                @($"{product.Price:0.00} DT")
                            </span>
                            @if (product.InStock)
                            {
                                <form method="post" asp-action="AddToCart" class="m-0">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="searchQuery" value="@Context.Request.Query["searchQuery"]" />
                                    <input type="hidden" name="categoryId" value="@Context.Request.Query["categoryId"]" />
                                    <button type="submit" class="btn btn-primary btn-sm cart-btn">
                                        <i class="fas fa-cart-plus"></i>
                                        @T("Ajouter", "Add", "أضف")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }

    </div>
</div>